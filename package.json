{
  "name": "cephasgm-ai",
  "version": "6.0.0",
  "description": "CephasGM SI — Superintelligence platform for Africa",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "prod": "NODE_ENV=production node api/server.js",
    "backend": "node api/server.js",
    "frontend": "cd client && npm run dev",
    "functions": "cd functions && npm run serve",
    "cluster": "node cluster/node-manager.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "npm run build:react",
    "deploy": "echo 'Deployment handled by Render'",
    "build:react": "cd client && npm install && npm run build",
    "status": "node -e \"console.log(require('./package.json').description)\"",
    "postinstall": "echo 'Dependencies installed successfully'"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^2.0.0",
    "@sentry/node": "^7.114.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.4",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": "20.18.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ai", "superintelligence", "si", "multimodal",
    "pwa", "firebase", "vector-database", "agent-framework", "llm", "africa"
  ],
  "author": "CephasGM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cephasgm/CephasGM-AI.git"
  },
  "bugs": { "url": "https://github.com/cephasgm/CephasGM-AI/issues" },
  "homepage": "https://cephasgm-ai.onrender.com",
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": ["/node_modules/", "/client/", "/functions/"]
  }
}
